{
  "expo": {
    "name": "BiyaHero",
    "slug": "biyahero",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FAF6ED",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "BiyaHero uses your location to show jeepneys near you on the map.",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ],
        "NSLocationAlwaysAndWhenInUseUsageDescription": "BiyaHero watches for your stop while you ride, even with the screen off."
      }
    },
    "android": {
      "package": "com.biyahero.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAF6ED"
      },
      "permissions": [
        "ACCESS_BACKGROUND_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "BiyaHero watches for your stop while you ride, even with the screen off.",
          "locationWhenInUsePermission": "BiyaHero uses your location to show jeepneys near you on the map.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "backgroundColor": "#FAF6ED",
          "imageWidth": 220
        }
      ],
      "expo-font",
      "expo-notifications"
    ],
    "extra": {
      "eas": {
        "projectId": "76cddceb-08bf-4ec8-a395-55e789c76759"
      }
    }
  }
}